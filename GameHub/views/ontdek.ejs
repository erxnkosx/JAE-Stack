<%- include("partials/header", { scripts: ['/js/ontdek.js', '/js/nav.js', '/js/active.js', '/js/suggesties.js'] }) %>
<%- include("partials/nav") %>

<main
        class="relative z-10 px-4 sm:px-6 md:px-10 lg:px-16 pt-10 sm:pt-14 md:pt-16 pb-16 sm:pb-20"
>
    <section class="max-w-6xl mx-auto text-center">
        <h1
                class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight text-white"
        >
            Ontdek
            <span
                    class="bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent"
            >
        geweldige games
      </span>
        </h1>

        <p
                class="mt-4 sm:mt-6 text-slate-400 text-base sm:text-lg md:text-2xl font-light"
        >
            Zoek in duizenden games en stel je perfecte collectie samen.
        </p>
    </section>

    <section class="max-w-5xl mx-auto mt-10 sm:mt-14">
        <form class="relative" action="/ontdek/suggestions" method="get">
        <input
                id="gameSearch"
                type="text"
                placeholder="Zoek games..."
                name="q"
                class="w-full rounded-2xl sm:rounded-3xl border border-white/10 bg-white/5 px-5 sm:px-7 md:px-10 py-4 sm:py-5 md:py-6 text-base sm:text-lg md:text-2xl text-white placeholder-slate-500 outline-none backdrop-blur-md"

        />

            <button formaction="/ontdek/suggestions" class="absolute right-5 top-0 bottom-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </button>
        </form>


        <section
                id="suggestions"
                class="hidden mt-2 rounded-2xl border border-white/10 glass-strong overflow-hidden"
        ></section>
    </section>


    <section class="max-w-7xl mx-auto mt-20">
        <% if (!isSearching) { %>
        <h2 class="text-3xl font-black text-white mb-6">Populaire games</h2>

        <nav class="flex items-center justify-between border-t border-white/10 pt-4">
            <% if (hasPreviousPage) { %>
                <a href="/ontdek?page=<%= currentPage - 1 %>" class="flex items-center gap-2 text-slate-400 hover:text-cyan-400 transition text-sm font-semibold">
                    ← Vorige
                </a>
            <% } else { %>
                <span class="flex items-center gap-2 text-slate-600 text-sm font-semibold cursor-not-allowed">
                    ← Vorige
                </span>
            <% } %>

            <div class="flex items-center gap-1">
                <% for(let i = Math.max(1, currentPage - 2); i <= Math.min(currentPage + 2, 500); i++) { %>
                    <% if (i === Math.max(1, currentPage - 2) && i > 1) { %>
                        <a href="/ontdek?page=1" class="px-3 py-1.5 rounded-lg text-sm font-semibold text-slate-400 hover:text-cyan-400 transition">1</a>
                        <span class="text-slate-600 px-1">...</span>
                    <% } %>
                    <a href="/ontdek?page=<%= i %>" class="px-3 py-1.5 rounded-lg text-sm font-semibold transition <%= i === currentPage ? 'bg-cyan-500/20 border border-cyan-500/30 text-cyan-400' : 'text-slate-400 hover:text-cyan-400' %>">
                        <%= i %>
                    </a>
                <% } %>
            </div>

            <% if (hasNextPage) { %>
                <a href="/ontdek?page=<%= currentPage + 1 %>" class="flex items-center gap-2 text-slate-400 hover:text-cyan-400 transition text-sm font-semibold">
                    Volgende →
                </a>
            <% } else { %>
                <span class="flex items-center gap-2 text-slate-600 text-sm font-semibold cursor-not-allowed">
                    Volgende →
                </span>
            <% } %>
        </nav>
        <% } %>
    </section>

    <section
            id="gamesStorage"
            class="max-w-7xl mx-auto mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
        <% games.forEach(game => { %>
            <article
                    class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
                    data-id="<%= game.id %>"
                    data-title="<%= game.name %>"
                    data-rating="<%= game.rating %>"
                    data-date="<%= game.released || 'Onbekend' %>"
                    data-image="<%= game.background_image %>"
            >
                <section class="relative">
                    <img loading="lazy" src="<%= game.background_image || '/images/placeholder.jpg' %>" alt="<%= game.name %>" class="w-full h-[420px] object-cover" />
                    <span class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></span>
                    <span class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold">
                        <span>⭐</span>
                        <span><%= game.rating || 'N/A' %></span>
                    </span>
                </section>
                <section class="p-6">
                    <h3 class="text-2xl font-bold text-white mb-2">
                        <%= game.name.split(" ").length > 3 ? game.name.split(" ").slice(0, 3).join(" ") + " ..." : game.name %>
                    </h3>

                    <p class="text-slate-300 text-sm leading-relaxed mb-3">
                        <%= game.description_raw ? game.description_raw.substring(0, 30) + "..." : "Geen beschrijving beschikbaar." %>
                    </p>

                    <p class="text-slate-400">
                        <%= game.released || 'Datum onbekend' %>
                    </p>
                </section>
            </article>
        <% }) %>
    </section>
</main>

<section
        id="gameDetails"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4"
>
    <section
            class="relative w-full max-w-5xl max-h-[90vh] overflow-y-auto rounded-3xl border border-cyan-500/30 bg-[#0b1120] shadow-[0_0_30px_rgba(34,211,238,0.2)] sm:grid sm:grid-cols-2"
    >
        <button
                id="closeGameDetails"
                class="absolute right-5 top-5 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/50 text-2xl text-slate-300 hover:text-white hover:bg-black/70 transition"
        >
            <span class="-translate-y-0.5 inline-block">×</span>
        </button>

        <section class="relative h-64 sm:h-auto sm:min-h-full">
            <img
                    loading="lazy"
                    id="gameCover"
                    src=""
                    alt=""
                    class="absolute inset-0 h-full w-full object-cover"
            />
        </section>

        <section class="flex flex-col gap-5 p-8 sm:p-10">
            <h2
                    id="gameTitle"
                    class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight pr-12"
            ></h2>

            <div>
                <span
                        id="collectionStatus"
                        class="inline-block rounded-full px-4 py-2 text-sm font-semibold bg-red-600 text-white"
                >
                    Niet in collectie
                </span>
            </div>

            <p
                    id="gameDescription"
                    class="text-slate-400 text-base leading-relaxed line-clamp-5"
            ></p>

            <p class="flex items-center gap-2 text-base text-yellow-400 font-semibold">
                <span>⭐</span><span id="gameRating"></span>
            </p>

            <p class="text-slate-400 text-base">
                Releasedatum: <span id="gameDate"></span>
            </p>

            <section class="pt-2">
                <h3
                        class="mb-3 text-cyan-400 text-xs font-semibold tracking-widest uppercase"
                >
                    Platformen
                </h3>
                <section id="gamePlatforms" class="flex flex-wrap gap-2 pt-2"></section>
            </section>

            <section class="mt-auto pt-4 flex flex-col gap-4">
                <button
                        id="collectionBtn"
                        class="w-full rounded-xl px-6 py-3.5 text-base font-semibold text-white transition bg-green-600 hover:bg-green-700"
                >
                    Voeg toe aan collectie
                </button>
            </section>
        </section>
    </section>
</section>
<section id="verwijderModal" style="display:none;" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70">
    <div class="bg-zinc-900 border border-white/10 rounded-2xl p-6 max-w-md mx-4">
        <p class="text-white mb-5">Weet je zeker dat je deze game wilt verwijderen?</p>
        <div class="flex gap-2 justify-center">
            <button onclick="closeVerwijder()" class="px-4 py-2 rounded-xl text-sm bg-white/5 text-slate-300">Annuleren</button>
            <button onclick="confirmDelete()" class="px-4 py-2 rounded-xl text-sm bg-red-600/20 text-red-400">Verwijderen</button>
        </div>
    </div>
</section>

<%- include("partials/footer") %>