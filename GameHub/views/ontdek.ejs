<%- include("partials/header", { scripts: ['/js/ontdek.js', '/js/nav.js', '/js/active.js', '/js/suggesties.js'] }) %>
<%- include("partials/nav") %>

<main
        class="relative z-10 px-4 sm:px-6 md:px-10 lg:px-16 pt-10 sm:pt-14 md:pt-16 pb-16 sm:pb-20"
>
    <section class="max-w-6xl mx-auto text-center">
        <h1
                class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight text-white"
        >
            Ontdek
            <span
                    class="bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent"
            >
        geweldige games
      </span>
        </h1>

        <p
                class="mt-4 sm:mt-6 text-slate-400 text-base sm:text-lg md:text-2xl font-light"
        >
            Zoek in duizenden games en stel je perfecte collectie samen.
        </p>
    </section>

    <section class="max-w-5xl mx-auto mt-10 sm:mt-14">
        <input
                id="gameSearch"
                type="text"
                placeholder="Zoek games..."
                class="w-full rounded-2xl sm:rounded-3xl border border-white/10 bg-white/5 px-5 sm:px-7 md:px-10 py-4 sm:py-5 md:py-6 text-base sm:text-lg md:text-2xl text-white placeholder-slate-500 outline-none backdrop-blur-md"
        />

        <section
                id="suggestions"
                class="hidden mt-2 rounded-2xl border border-white/10 glass-strong overflow-hidden"
        ></section>
    </section>

    <section class="max-w-6xl mx-auto mt-20 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <h2 class="text-3xl font-black text-white">Populaire games</h2>

        <section class="flex items-center gap-6">
            <% if (hasPreviousPage) { %>
                <a
                        href="/ontdek?page=<%= currentPage - 1 %>"
                        class="text-cyan-400 text-xl hover:text-white"
                >
                    ← vorige
                </a>
            <% } %>

            <span class="text-white text-xl font-bold">
        Pagina <%= currentPage %>
      </span>

            <% if (hasNextPage) { %>
                <a
                        href="/ontdek?page=<%= currentPage + 1 %>"
                        class="text-cyan-400 text-xl hover:text-white"
                >
                    volgende →
                </a>
            <% } %>
        </section>
    </section>

    <section
            id="gamesStorage"
            class="max-w-6xl mx-auto mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
        <% games.forEach(game => { %>
            <article
                    class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
                    data-id="<%= game.id %>"
                    data-title="<%= game.name %>"
                    data-description="<%= game.description || 'Geen beschrijving beschikbaar.' %>"
                    data-rating="<%= game.rating %>"
                    data-date="<%= game.released || 'Onbekend' %>"
                    data-image="<%= game.background_image %>"
            >
                <section class="relative">
                    <img
                            src="<%= game.background_image || '/images/placeholder.jpg' %>"
                            alt="<%= game.name %>"
                            class="w-full h-[420px] object-cover"
                    />

                    <span
                            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
                    ></span>

                    <span
                            class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold"
                    >
            <span>⭐</span>
            <span><%= game.rating || 'N/A' %></span>
          </span>
                </section>

                <section class="p-6">
                    <h3 class="text-2xl font-bold text-white mb-2">
                        <%= game.name %>
                    </h3>

                    <p class="text-slate-300 text-sm leading-relaxed mb-3">
                        Geen beschrijving beschikbaar.
                    </p>

                    <p class="text-slate-400">
                        <%= game.released || 'Onbekend' %>
                    </p>
                </section>
            </article>
        <% }) %>
    </section>
</main>

<section
        id="gameDetails"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm px-4 sm:px-6"
>
    <section
            class="relative w-full max-w-6xl max-h-[90vh] overflow-y-auto rounded-2xl sm:rounded-3xl border border-cyan-500/30 bg-[#0b1120] shadow-[0_0_30px_rgba(34,211,238,0.2)] lg:grid lg:grid-cols-2"
    >
        <button
                id="closeGameDetails"
                class="absolute right-4 top-4 sm:right-5 sm:top-5 z-10 flex h-11 w-11 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-white/10 text-2xl sm:text-3xl text-slate-300 hover:text-white"
        >
            <span class="-translate-y-0.5 inline-block">×</span>
        </button>

        <section class="relative h-[260px] sm:h-[340px] lg:h-full">
            <img
                    id="gameCover"
                    src=""
                    alt=""
                    class="h-full w-full object-cover"
            />
        </section>

        <section class="flex flex-col gap-5 sm:gap-7 p-5 sm:p-8 lg:p-12">
            <section class="flex flex-col items-start gap-5 sm:gap-8">
                <h2
                        id="gameTitle"
                        class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight"
                ></h2>

                <span
                        id="collectionStatus"
                        class="rounded-full px-4 py-2 text-sm font-semibold bg-red-600 text-white"
                >
          Niet in collectie
        </span>
            </section>

            <p
                    id="gameDescription"
                    class="text-slate-400 text-base sm:text-lg leading-relaxed max-w-xl"
            ></p>

            <p
                    class="flex items-center gap-2 text-base sm:text-lg text-yellow-400 font-semibold"
            >
                <span>⭐</span>
                <span id="gameRating"></span>
            </p>

            <p class="text-slate-400 text-base sm:text-lg">
                Releasedatum: <span id="gameDate"></span>
            </p>

            <section>
                <h3
                        class="mb-4 text-cyan-400 text-sm font-semibold tracking-widest uppercase"
                >
                    Platformen
                </h3>

                <section id="gamePlatforms" class="flex flex-wrap gap-3">
          <span
                  class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
          >PC</span>

                    <span
                            class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
                    >
            PlayStation 5
          </span>

                    <span
                            class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
                    >
            Xbox One
          </span>
                </section>
            </section>

            <section class="mt-auto pt-4 flex flex-col gap-4">
                <button
                        id="collectionBtn"
                        class="w-full sm:w-fit sm:min-w-[260px] rounded-xl px-6 sm:px-8 py-3 sm:py-4 text-base sm:text-xl font-semibold text-white transition bg-green-600 hover:bg-green-700"
                >
                    Voeg toe aan collectie
                </button>
                <section class="flex flex-col gap-3">
                    <p class="text-sm text-slate-400 font-semibold pt-3 sm:pt-5">
                        Kies status
                    </p>
                    <section class="flex flex-wrap gap-3 pt-2">
                        <button
                                id="setBacklog"
                                class="px-4 py-2 rounded-xl bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                        >
                            Nog te spelen
                        </button>
                        <button
                                id="setPlaying"
                                class="px-4 py-2 rounded-xl bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                        >
                            Aan het spelen
                        </button>
                        <button
                                id="setFinished"
                                class="px-4 py-2 rounded-xl bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                        >
                            Uitgespeeld
                        </button>
                    </section>
                </section>
            </section>
        </section>
    </section>
</section>

<%- include("partials/footer") %>