<%- include("partials/header", { scripts: ['/js/ontdek.js', '/js/nav.js', '/js/active.js', '/js/suggesties.js'] }) %>
<%- include("partials/nav") %>

    

    <main
      class="relative z-10 px-4 sm:px-6 md:px-10 lg:px-16 pt-10 sm:pt-14 md:pt-16 pb-16 sm:pb-20"
    >
      <section class="max-w-6xl mx-auto text-center">
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight text-white"
        >
          Ontdek
          <span
            class="bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent"
            >geweldige games</span
          >
        </h1>

        <p
          class="mt-4 sm:mt-6 text-slate-400 text-base sm:text-lg md:text-2xl font-light"
        >
          Zoek in duizenden games en stel je perfecte collectie samen.
        </p>
      </section>

      <section class="max-w-5xl mx-auto mt-10 sm:mt-14">
        <input
          id="gameSearch"
          type="text"
          placeholder="Zoek games..."
          class="w-full rounded-2xl sm:rounded-3xl border border-white/10 bg-white/5 px-5 sm:px-7 md:px-10 py-4 sm:py-5 md:py-6 text-base sm:text-lg md:text-2xl text-white placeholder-slate-500 outline-none backdrop-blur-md"
        />
        <section
          id="suggestions"
          class="hidden mt-2 rounded-2xl border border-white/10 glass-strong overflow-hidden"
        ></section>
      </section>

      <section class="mt-20 grid grid-cols-3 items-center">
        <section class="flex justify-start">
          <h2 class="text-3xl font-black text-white">Populaire games</h2>
        </section>

        <section class="flex justify-center items-center gap-6">
          <a href="/ontdek" class="text-white text-xl font-bold">1</a>
          <a
            href="/ontdek-2.html"
            class="text-slate-400 text-xl hover:text-white"
            >2</a
          >
        </section>

        <section class="flex justify-end">
          <a
            href="/ontdek-2.html"
            class="text-cyan-400 text-xl hover:text-white"
            >volgende →</a
          >
        </section>
      </section>

      <section
        id="gamesStorage"
        class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        <article
          class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
          data-id="little-nightmares"
          data-title="Little Nightmares"
          data-description="Een donkere horror-platformgame waarin je als Six ontsnapt uit een griezelige wereld vol gevaar."
          data-rating="4.03"
          data-date="2017-04-27"
          data-image="https://media.rawg.io/media/games/8a0/8a02f84a5916ede2f923b88d5f8217ba.jpg"
        >
          <section class="relative">
            <img
              src="https://media.rawg.io/media/games/8a0/8a02f84a5916ede2f923b88d5f8217ba.jpg"
              alt="Little Nightmares"
              class="w-full h-[420px] object-cover"
            />
            <span
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
            ></span>
            <span
              class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold"
            >
              <span>⭐</span><span>4.03</span>
            </span>
          </section>

          <section class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">
              Little Nightmares
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              Een donkere horror-platformgame waarin je als Six ontsnapt uit een
              griezelige wereld vol gevaar.
            </p>
            <p class="text-slate-400">2017-04-27</p>
          </section>
        </article>

        <article
          class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
          data-id="bioshock-2"
          data-title="BioShock 2"
          data-description="Een sfeervolle shooter in de onderwaterstad Rapture waarin je speelt als een machtige Big Daddy."
          data-rating="4.07"
          data-date="2010-02-09"
          data-image="https://media.rawg.io/media/games/157/15742f2f67eacff546738e1ab5c19d20.jpg"
        >
          <section class="relative">
            <img
              src="https://media.rawg.io/media/games/157/15742f2f67eacff546738e1ab5c19d20.jpg"
              alt="BioShock 2"
              class="w-full h-[420px] object-cover"
            />
            <span
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
            ></span>
            <span
              class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold"
            >
              <span>⭐</span><span>4.07</span>
            </span>
          </section>

          <section class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">BioShock 2</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              Een sfeervolle shooter in de onderwaterstad Rapture waarin je
              speelt als een machtige Big Daddy.
            </p>
            <p class="text-slate-400">2010-02-09</p>
          </section>
        </article>

        <article
          class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
          data-id="half-life"
          data-title="Half-Life"
          data-description="Een legendarische first-person shooter waarin Gordon Freeman moet overleven na een experiment dat fout loopt."
          data-rating="4.38"
          data-date="1998-11-19"
          data-image="https://media.rawg.io/media/games/6c5/6c55e22185876626881b76c11922b073.jpg"
        >
          <section class="relative">
            <img
              src="https://media.rawg.io/media/games/6c5/6c55e22185876626881b76c11922b073.jpg"
              alt="Half-Life"
              class="w-full h-[420px] object-cover"
            />
            <span
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
            ></span>
            <span
              class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold"
            >
              <span>⭐</span><span>4.38</span>
            </span>
          </section>

          <section class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">Half-Life</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              Een legendarische first-person shooter waarin Gordon Freeman moet
              overleven na een experiment dat fout loopt.
            </p>
            <p class="text-slate-400">1998-11-19</p>
          </section>
        </article>

        <article
          class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
          data-id="mirrors-edge"
          data-title="Mirror's Edge"
          data-description="Een snelle parkour-actiongame waarin je door een futuristische stad rent en vijanden ontwijkt."
          data-rating="4.07"
          data-date="2008-11-11"
          data-image="https://media.rawg.io/media/games/8e4/8e4de3f54ac659e08a7ba6a2b731682a.jpg"
        >
          <section class="relative">
            <img
              src="https://media.rawg.io/media/games/8e4/8e4de3f54ac659e08a7ba6a2b731682a.jpg"
              alt="Mirror's Edge"
              class="w-full h-[420px] object-cover"
            />
            <span
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
            ></span>
            <span
              class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold"
            >
              <span>⭐</span><span>4.07</span>
            </span>
          </section>

          <section class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">Mirror's Edge</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              Een snelle parkour-actiongame waarin je door een futuristische
              stad rent en vijanden ontwijkt.
            </p>
            <p class="text-slate-400">2008-11-11</p>
          </section>
        </article>

        <article
          class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
          data-id="hotline-miami"
          data-title="Hotline Miami"
          data-description="Een gewelddadige top-down actiongame met snelle gameplay, neonstijl en een intense soundtrack."
          data-rating="4.38"
          data-date="2012-10-23"
          data-image="https://media.rawg.io/media/games/9fa/9fa63622543e5d4f6d99aa9d73b043de.jpg"
        >
          <section class="relative">
            <img
              src="https://media.rawg.io/media/games/9fa/9fa63622543e5d4f6d99aa9d73b043de.jpg"
              alt="Hotline Miami"
              class="w-full h-[420px] object-cover"
            />
            <span
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
            ></span>
            <span
              class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold"
            >
              <span>⭐</span><span>4.38</span>
            </span>
          </section>

          <section class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">Hotline Miami</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              Een gewelddadige top-down actiongame met snelle gameplay,
              neonstijl en een intense soundtrack.
            </p>
            <p class="text-slate-400">2012-10-23</p>
          </section>
        </article>

        <article
          class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
          data-id="hitman"
          data-title="Hitman"
          data-description="Een stealthgame waarin Agent 47 doelwitten uitschakelt met planning, vermommingen en precisie."
          data-rating="3.93"
          data-date="2016-03-11"
          data-image="https://media.rawg.io/media/games/16b/16b1b7b36e2042d1128d5a3e852b3b2f.jpg"
          data-platforms="PC, PlayStation 4, Xbox One"
        >
          <section class="relative">
            <img
              src="https://media.rawg.io/media/games/16b/16b1b7b36e2042d1128d5a3e852b3b2f.jpg"
              alt="Hitman"
              class="w-full h-[420px] object-cover"
            />
            <span
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
            ></span>
            <span
              class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold"
            >
              <span>⭐</span><span>3.93</span>
            </span>
          </section>

          <section class="p-6">
            <h3 class="text-2xl font-bold text-white mb-2">Hitman</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              Een stealthgame waarin Agent 47 doelwitten uitschakelt met
              planning, vermommingen en precisie.
            </p>
            <p class="text-slate-400">2016-03-11</p>
          </section>
        </article>
      </section>
    </main>

    <section
      id="gameDetails"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm px-4 sm:px-6"
    >
      <section
        class="relative w-full max-w-6xl max-h-[90vh] overflow-y-auto rounded-2xl sm:rounded-3xl border border-cyan-500/30 bg-[#0b1120] shadow-[0_0_30px_rgba(34,211,238,0.2)] lg:grid lg:grid-cols-2"
      >
        <button
          id="closeGameDetails"
          class="absolute right-4 top-4 sm:right-5 sm:top-5 z-10 flex h-11 w-11 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-white/10 text-2xl sm:text-3xl text-slate-300 hover:text-white"
        >
          <span class="-translate-y-0.5 inline-block">×</span>
        </button>

        <section class="relative h-[260px] sm:h-[340px] lg:h-full">
          <img
            id="gameCover"
            src=""
            alt=""
            class="h-full w-full object-cover"
          />
        </section>

        <section class="flex flex-col gap-5 sm:gap-7 p-5 sm:p-8 lg:p-12">
          <section class="flex flex-col items-start gap-5 sm:gap-8">
            <h2
              id="gameTitle"
              class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight"
            ></h2>

            <span
              id="collectionStatus"
              class="rounded-full px-4 py-2 text-sm font-semibold bg-red-600 text-white"
            >
              Niet in collectie
            </span>
          </section>

          <p
            id="gameDescription"
            class="text-slate-400 text-base sm:text-lg leading-relaxed max-w-xl"
          ></p>

          <p
            class="flex items-center gap-2 text-base sm:text-lg text-yellow-400 font-semibold"
          >
            <span>⭐</span><span id="gameRating"></span>
          </p>

          <p class="text-slate-400 text-base sm:text-lg">
            Releasedatum: <span id="gameDate"></span>
          </p>

          <section>
            <h3
              class="mb-4 text-cyan-400 text-sm font-semibold tracking-widest uppercase"
            >
              Platformen
            </h3>
            <section id="gamePlatforms" class="flex flex-wrap gap-3">
              <span
                class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
                >PC</span
              >
              <span
                class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
                >PlayStation 5</span
              >
              <span
                class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
                >Xbox One</span
              >
            </section>
          </section>

          <section class="mt-auto pt-4 flex flex-col gap-4">
            <button
              id="collectionBtn"
              class="w-full sm:w-fit sm:min-w-[260px] rounded-xl px-6 sm:px-8 py-3 sm:py-4 text-base sm:text-xl font-semibold text-white transition bg-green-600 hover:bg-green-700"
            >
              Voeg toe aan collectie
            </button>

            <section class="flex flex-col gap-3">
              <p class="text-sm text-slate-400 font-semibold pt-3 sm:pt-5">
                Kies status
              </p>

              <section class="flex flex-wrap gap-3 pt-2">
                <button
                  id="setBacklog"
                  class="px-4 py-2 rounded-xl bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                >
                  Nog te spelen
                </button>

                <button
                  id="setPlaying"
                  class="px-4 py-2 rounded-xl bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                >
                  Aan het spelen
                </button>

                <button
                  id="setFinished"
                  class="px-4 py-2 rounded-xl bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                >
                  Uitgespeeld
                </button>
              </section>
            </section>
          </section>
        </section>
      </section>
    </section>
<%- include("partials/footer") %>
