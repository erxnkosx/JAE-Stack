<%- include("partials/header", { scripts: ['/js/ontdek.js', '/js/nav.js', '/js/active.js', '/js/suggesties.js'] }) %>
<%- include("partials/nav") %>

<main
        class="relative z-10 px-4 sm:px-6 md:px-10 lg:px-16 pt-10 sm:pt-14 md:pt-16 pb-16 sm:pb-20"
>
    <section class="max-w-6xl mx-auto text-center">
        <h1
                class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight text-white"
        >
            Ontdek
            <span
                    class="bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent"
            >
        geweldige games
      </span>
        </h1>

        <p
                class="mt-4 sm:mt-6 text-slate-400 text-base sm:text-lg md:text-2xl font-light"
        >
            Zoek in duizenden games en stel je perfecte collectie samen.
        </p>
    </section>

    <section class="max-w-5xl mx-auto mt-10 sm:mt-14">
        <form class="relative">
        <input
                id="gameSearch"
                type="text"
                placeholder="Zoek games..."
                name="q"
                class="w-full rounded-2xl sm:rounded-3xl border border-white/10 bg-white/5 px-5 sm:px-7 md:px-10 py-4 sm:py-5 md:py-6 text-base sm:text-lg md:text-2xl text-white placeholder-slate-500 outline-none backdrop-blur-md"
        />

            <button formaction="/ontdek/suggestions" class="absolute right-5 top-0 bottom-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </button>
        </form>


        <section
                id="suggestions"
                class="hidden mt-2 rounded-2xl border border-white/10 glass-strong overflow-hidden"
        ></section>
    </section>


    <section class="max-w-7xl mx-auto mt-20">
        <% if (!isSearching) { %>
        <h2 class="text-3xl font-black text-white mb-6">Populaire games</h2>

        <nav class="flex items-center justify-between border-t border-white/10 pt-4">
            <% if (hasPreviousPage) { %>
                <a href="/ontdek?page=<%= currentPage - 1 %>" class="flex items-center gap-2 text-slate-400 hover:text-cyan-400 transition text-sm font-semibold">
                    ← Vorige
                </a>
            <% } else { %>
                <span class="flex items-center gap-2 text-slate-600 text-sm font-semibold cursor-not-allowed">
                    ← Vorige
                </span>
            <% } %>

            <div class="flex items-center gap-1">
                <% for(let i = Math.max(1, currentPage - 2); i <= Math.min(currentPage + 2, 500); i++) { %>
                    <% if (i === Math.max(1, currentPage - 2) && i > 1) { %>
                        <a href="/ontdek?page=1" class="px-3 py-1.5 rounded-lg text-sm font-semibold text-slate-400 hover:text-cyan-400 transition">1</a>
                        <span class="text-slate-600 px-1">...</span>
                    <% } %>
                    <a href="/ontdek?page=<%= i %>" class="px-3 py-1.5 rounded-lg text-sm font-semibold transition <%= i === currentPage ? 'bg-cyan-500/20 border border-cyan-500/30 text-cyan-400' : 'text-slate-400 hover:text-cyan-400' %>">
                        <%= i %>
                    </a>
                <% } %>
            </div>

            <% if (hasNextPage) { %>
                <a href="/ontdek?page=<%= currentPage + 1 %>" class="flex items-center gap-2 text-slate-400 hover:text-cyan-400 transition text-sm font-semibold">
                    Volgende →
                </a>
            <% } else { %>
                <span class="flex items-center gap-2 text-slate-600 text-sm font-semibold cursor-not-allowed">
                    Volgende →
                </span>
            <% } %>
        </nav>
        <% } %>
    </section>

    <section
            id="gamesStorage"
            class="max-w-7xl mx-auto mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
        <% games.forEach(game => { %>
            <article
                    class="game-card group rounded-3xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-md hover:scale-[1.02] transition duration-300"
                    data-id="<%= game.id %>"
                    data-title="<%= game.name %>"
                    data-description="<%= game.description || 'Geen beschrijving beschikbaar.' %>"
                    data-rating="<%= game.rating %>"
                    data-date="<%= game.released || 'Onbekend' %>"
                    data-image="<%= game.background_image %>"
            >
                <section class="relative">
                    <img src="<%= game.background_image || '/images/placeholder.jpg' %>" alt="<%= game.name %>" class="w-full h-[420px] object-cover" />
                    <span class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></span>
                    <span class="absolute top-4 left-4 flex items-center gap-2 bg-zinc-900/80 text-yellow-400 px-4 py-2 rounded-2xl text-lg font-bold">
                        <span>⭐</span>
                        <span><%= game.rating || 'N/A' %></span>
                    </span>
                </section>
                <section class="p-6">
                    <h3 class="text-2xl font-bold text-white mb-2">
                        <%= game.name.split(" ").length > 3 ? game.name.split(" ").slice(0, 3).join(" ") + " ..." : game.name %>
                    </h3>

                    <p class="text-slate-300 text-sm leading-relaxed mb-3">
                        <%= game.description_raw ? game.description_raw.substring(0, 30) + "..." : "Geen beschrijving beschikbaar." %>
                    </p>

                    <p class="text-slate-400">
                        <%= game.released || 'Datum onbekend' %>
                    </p>
                </section>
            </article>
        <% }) %>
    </section>
</main>

<section
        id="gameDetails"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm px-4 sm:px-6"
>
    <section
            class="relative w-full max-w-6xl max-h-[90vh] overflow-y-auto rounded-2xl sm:rounded-3xl border border-cyan-500/30 bg-[#0b1120] shadow-[0_0_30px_rgba(34,211,238,0.2)] lg:grid lg:grid-cols-2"
    >
        <button
                id="closeGameDetails"
                class="absolute right-4 top-4 sm:right-5 sm:top-5 z-10 flex h-11 w-11 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-white/10 text-2xl sm:text-3xl text-slate-300 hover:text-white"
        >
            <span class="-translate-y-0.5 inline-block">×</span>
        </button>

        <section class="relative h-[260px] sm:h-[340px] lg:h-full">
            <img
                    id="gameCover"
                    src=""
                    alt=""
                    class="h-full w-full object-cover"
            />
        </section>

        <section class="flex flex-col gap-5 sm:gap-7 p-5 sm:p-8 lg:p-12">
            <section class="flex flex-col items-start gap-5 sm:gap-8">
                <h2
                        id="gameTitle"
                        class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight"
                ></h2>

                <span
                        id="collectionStatus"
                        class="rounded-full px-4 py-2 text-sm font-semibold bg-red-600 text-white"
                >
          Niet in collectie
        </span>
            </section>

            <p
                    id="gameDescription"
                    class="text-slate-400 text-base sm:text-lg leading-relaxed max-w-xl"
            ></p>

            <p
                    class="flex items-center gap-2 text-base sm:text-lg text-yellow-400 font-semibold"
            >
                <span>⭐</span>
                <span id="gameRating"></span>
            </p>

            <p class="text-slate-400 text-base sm:text-lg">
                Releasedatum: <span id="gameDate"></span>
            </p>

            <section>
                <h3
                        class="mb-4 text-cyan-400 text-sm font-semibold tracking-widest uppercase"
                >
                    Platformen
                </h3>

                <section id="gamePlatforms" class="flex flex-wrap gap-3">
          <span
                  class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
          ><svg class="w-6 h-6" version="1.1" id="_x32_" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512 512" xml:space="preserve" fill="#ffffff" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <style type="text/css">  .st0{fill:#ffffff;}  </style> <g> <path class="st0" d="M477.984,39.203H34.016C15.219,39.203,0,54.438,0,73.219v283.969c0,18.781,15.219,34.016,34.016,34.016H220 v7.578c0,18.781-15.219,34.016-34.016,34.016H136v40h73.188h93.625H376v-40h-49.984c-18.797,0-34.016-15.234-34.016-34.016v-7.578 h185.984c18.797,0,34.016-15.234,34.016-34.016V73.219C512,54.438,496.781,39.203,477.984,39.203z M464,315.859 c0,6.266-5.078,11.344-11.344,11.344H59.344c-6.266,0-11.344-5.078-11.344-11.344V98.547c0-6.266,5.078-11.344,11.344-11.344 h393.313c6.266,0,11.344,5.078,11.344,11.344V315.859z"></path> </g> </g></svg></span>

                    <span
                            class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
                    >
            <svg class="w-6 h-6" fill="#ffffff" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <title>playstation</title> <path d="M3.262 24.248c-2.374-0.681-2.767-2.084-1.69-2.899 0.776-0.51 1.668-0.954 2.612-1.288l0.087-0.027 7.017-2.516v2.89l-5.030 1.839c-0.881 0.339-1.031 0.79-0.299 1.032 0.365 0.093 0.783 0.147 1.214 0.147 0.615 0 1.204-0.109 1.749-0.308l-0.035 0.011 2.422-0.882v2.592c-0.15 0.037-0.32 0.055-0.487 0.091-0.775 0.136-1.667 0.214-2.577 0.214-1.778 0-3.486-0.298-5.078-0.846l0.11 0.033zM18.049 24.544l7.868-2.843c0.893-0.322 1.032-0.781 0.307-1.022-0.363-0.089-0.779-0.14-1.208-0.14-0.622 0-1.22 0.108-1.774 0.305l0.037-0.011-5.255 1.874v-2.983l0.3-0.106c1.050-0.349 2.284-0.62 3.557-0.761l0.083-0.008c0.468-0.050 1.010-0.078 1.559-0.078 1.877 0 3.677 0.331 5.343 0.939l-0.108-0.035c2.309 0.751 2.549 1.839 1.969 2.589-0.559 0.557-1.235 0.998-1.988 1.282l-0.039 0.013-10.677 3.883v-2.869zM12.231 4.248v21.927l4.892 1.576v-18.39c0-0.862 0.38-1.438 0.992-1.238 0.795 0.225 0.95 1.017 0.95 1.881v7.342c3.050 1.491 5.451-0.003 5.451-3.939 0-4.045-1.407-5.842-5.546-7.282-1.785-0.648-4.040-1.294-6.347-1.805l-0.389-0.072z"></path> </g></svg>
          </span>

                    <span
                            class="rounded-full bg-white/10 px-5 py-3 text-lg text-slate-200"
                    >
            <svg class="w-6 h-6" fill="#ffffff" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <title>xbox</title> <path d="M16 5.425c-1.888-1.125-4.106-1.922-6.473-2.249l-0.092-0.010c-0.070-0.005-0.152-0.008-0.234-0.008-0.613 0-1.188 0.16-1.687 0.441l0.017-0.009c2.357-1.634 5.277-2.61 8.426-2.61 0.008 0 0.016 0 0.024 0h0.019c0.005 0 0.011 0 0.018 0 3.157 0 6.086 0.976 8.501 2.642l-0.050-0.033c-0.478-0.272-1.051-0.433-1.662-0.433-0.085 0-0.169 0.003-0.252 0.009l0.011-0.001c-2.459 0.336-4.677 1.13-6.648 2.297l0.082-0.045zM5.554 5.268c-0.041 0.014-0.077 0.032-0.11 0.054l0.002-0.001c-2.758 2.723-4.466 6.504-4.466 10.684 0 3.584 1.256 6.875 3.353 9.457l-0.022-0.028c-1.754-3.261 4.48-12.455 7.61-16.159-3.53-3.521-5.277-4.062-6.015-4.062-0.010-0-0.021-0.001-0.032-0.001-0.115 0-0.225 0.021-0.326 0.060l0.006-0.002zM20.083 9.275c3.129 3.706 9.367 12.908 7.605 16.161 2.075-2.554 3.332-5.845 3.332-9.43 0-4.181-1.709-7.962-4.467-10.684l-0.002-0.002c-0.029-0.021-0.063-0.039-0.1-0.052l-0.003-0.001c-0.1-0.036-0.216-0.056-0.336-0.056-0.005 0-0.011 0-0.016 0h0.001c-0.741-0-2.485 0.543-6.014 4.063zM6.114 27.306c2.627 2.306 6.093 3.714 9.888 3.714s7.261-1.407 9.905-3.728l-0.017 0.015c2.349-2.393-5.402-10.901-9.89-14.29-4.483 3.39-12.24 11.897-9.886 14.29z"></path> </g></svg>
          </span>
                </section>
            </section>

            <section class="mt-auto pt-4 flex flex-col gap-4">
                <button
                        id="collectionBtn"
                        class="w-full sm:w-fit sm:min-w-[260px] rounded-full px-6 sm:px-8 py-3 sm:py-4 text-base sm:text-xl font-semibold text-white transition bg-green-600 hover:bg-green-700"
                >
                    Voeg toe aan collectie
                </button>
                <section class="flex flex-col gap-3">
                    <p class="text-sm text-slate-400 font-semibold pt-3 sm:pt-5">
                        Kies status
                    </p>
                    <section class="flex flex-wrap gap-3 pt-2">
                        <button
                                id="setBacklog"
                                class="px-4 py-2 rounded-full bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                        >
                            Nog te spelen
                        </button>
                        <button
                                id="setPlaying"
                                class="px-4 py-2 rounded-full bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                        >
                            Aan het spelen
                        </button>
                        <button
                                id="setFinished"
                                class="px-4 py-2 rounded-full bg-gray-900/50 border border-gray-800 text-sm font-semibold text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition"
                        >
                            Uitgespeeld
                        </button>
                    </section>
                </section>
            </section>
        </section>
    </section>
</section>

<%- include("partials/footer") %>