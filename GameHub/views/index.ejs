<%- include("partials/header", { scripts: ['/js/index.js'] }) %>

  <main class="animate-fadeIn relative min-h-screen flex flex-col justify-center px-4 sm:px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-30 py-6 sm:py-8 md:py-12 lg:py-16">
    <div class="w-full relative flex flex-wrap items-center justify-end gap-2 sm:gap-3 mb-8 sm:mb-10 md:mb-13 min-h-[40px]">
      <% if (!locals.user) { %>
        <a href="/login" class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition text-xs sm:text-sm font-semibold">Login</a>
        <a href="/signup" class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl bg-gradient-to-r from-purple-500 to-pink-500 text-white text-xs sm:text-sm font-semibold">Registreer</a>
      <% } %>
    </div>
    <% if (locals.message) { %>
      <div class="w-max mx-auto text-center px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold mb-6 <%= message.type === 'success' ? 'bg-green-600/20 text-green-400 border border-green-500/30' : 'bg-red-600/20 text-red-400 border border-red-500/30' %>">
        <%= message.message %>
      </div>
    <% } %>
    <section class="flex flex-col items-center text-center w-full">
        <h1 class="text-2xl xs:text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-black leading-tight gradient-text mb-3 sm:mb-4 md:mb-6 animate-gradient">
          Welkom bij de projectselectie
        </h1>
        <p class="text-slate-400 text-sm sm:text-base md:text-lg xl:text-xl font-light">
          Maak een keuze
        </p>
      </section>

      <section class="w-full max-w-7xl mx-auto mt-8 sm:mt-10 md:mt-12 lg:mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 md:gap-6 px-1 sm:px-2">
        <article
          class="group w-full relative ring-2 ring-white/10 hover:ring-cyan-500/50 transition-all duration-700 hover:scale-[1.02] hover:-translate-y-2 overflow-hidden rounded-2xl sm:rounded-3xl flex flex-col p-3 sm:p-4 min-h-[260px] sm:min-h-[300px] md:min-h-[340px] lg:min-h-[460px] xl:min-h-[520px] bg-[url('https://images.unsplash.com/photo-1633499737221-5e3406d4d952?w=800')] bg-cover bg-center bg-no-repeat before:absolute before:content-[''] before:inset-0 before:bg-linear-to-t before:from-black before:via-black/80 before:to-black/40 md:col-span-2 lg:col-span-1">
          <span
            class="absolute top-2 sm:top-3 right-2 sm:right-3 px-2.5 sm:px-3 py-1 sm:py-1.5 bg-linear-to-r from-cyan-500 to-purple-500 text-white text-xs sm:text-sm md:text-[15px] rounded-full font-bold shadow-xl animate-pulse">
            Actief
          </span>

          <section class="relative z-10 mt-auto flex flex-col gap-2 sm:gap-3 md:gap-4">
            <div class="space-y-1 sm:space-y-2">
              <h3
                class="font-black text-white text-2xl sm:text-3xl md:text-4xl lg:text-3xl xl:text-4xl 2xl:text-5xl group-hover:text-transparent bg-clip-text bg-linear-to-r from-cyan-300 to-purple-300 transition-colors duration-700"
              >
                GameHub
              </h3>

              <p
                class="text-slate-300 font-light text-xs sm:text-sm md:text-base max-w-[38ch]"
              >
                Ontdek en verzamel je favoriete games
              </p>
            </div>

            <a
              href="/check-login"
              class="relative overflow-hidden inline-flex items-center justify-center gap-2 w-full px-3 sm:px-4 py-2.5 sm:py-3 text-white text-xs sm:text-sm font-semibold rounded-lg sm:rounded-xl bg-linear-to-r from-cyan-500 via-purple-500 to-pink-500 animate-gradient before:absolute before:inset-0 before:bg-gradient-to-r before:from-transparent before:via-white/50 before:to-transparent before:translate-x-[-200%] hover:before:translate-x-[200%] before:transition-transform before:duration-700"
            >
              <span class="whitespace-nowrap">Betreed universum</span>
              <svg
                class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                stroke="#000000"
              >
                <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                <g
                  id="SVGRepo_tracerCarrier"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></g>
                <g id="SVGRepo_iconCarrier">
                  <path
                    d="M5 12H19M19 12L13 6M19 12L13 18"
                    stroke="#ffffff"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </g>
              </svg>
            </a>
          </section>
        </article>

        <article
          class="not-available w-full relative ring-2 overflow-hidden ring-white/10 rounded-2xl sm:rounded-3xl min-h-[220px] sm:min-h-[260px] md:min-h-[340px] lg:min-h-[460px] xl:min-h-[520px] bg-[url('https://images.unsplash.com/photo-1639234912114-71f8c6d58ba8?q=80&w=1268&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D')] bg-cover bg-center bg-no-repeat before:absolute before:content-[''] before:inset-0 before:bg-linear-to-t before:from-black/80 before:via-black/50 before:to-black/20"
        >
          <section
            class="relative h-full flex flex-col items-center justify-center gap-4 sm:gap-5 md:gap-6 p-4 sm:p-6"
          >
            <span
              class="absolute top-2 sm:top-3 right-2 sm:right-3 px-2.5 sm:px-3 py-1 sm:py-1.5 glass text-slate-500 text-[11px] xs:text-xs sm:text-sm md:text-[15px] rounded-full font-semibold"
            >
              Binnenkort beschikbaar
            </span>

            <svg
              class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M7 10.0288C7.47142 10 8.05259 10 8.8 10H15.2C15.9474 10 16.5286 10 17 10.0288M7 10.0288C6.41168 10.0647 5.99429 10.1455 5.63803 10.327C5.07354 10.6146 4.6146 11.0735 4.32698 11.638C4 12.2798 4 13.1198 4 14.8V16.2C4 17.8802 4 18.7202 4.32698 19.362C4.6146 19.9265 5.07354 20.3854 5.63803 20.673C6.27976 21 7.11984 21 8.8 21H15.2C16.8802 21 17.7202 21 18.362 20.673C18.9265 20.3854 19.3854 19.9265 19.673 19.362C20 18.7202 20 17.8802 20 16.2V14.8C20 13.1198 20 12.2798 19.673 11.638C19.3854 11.0735 18.9265 10.6146 18.362 10.327C18.0057 10.1455 17.5883 10.0647 17 10.0288M7 10.0288V8C7 5.23858 9.23858 3 12 3C14.7614 3 17 5.23858 17 8V10.0288"
                stroke="#ffffff"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>

            <section>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-500 mb-2 sm:mb-3 text-center">
                LegoMasters
              </h3>
              <p class="text-sm sm:text-base text-slate-500 text-center">Bouw jouw wereld</p>
            </section>
          </section>
        </article>

        <article
          class="not-available w-full relative ring-2 overflow-hidden ring-white/10 rounded-2xl sm:rounded-3xl min-h-[220px] sm:min-h-[260px] md:min-h-[340px] lg:min-h-[460px] xl:min-h-[520px] bg-[url('https://images.unsplash.com/photo-1525362081669-2b476bb628c3?q=80&w=1287&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D')] bg-cover bg-center bg-no-repeat before:absolute before:content-[''] before:inset-0 before:bg-linear-to-t before:from-black before:via-black/60 before:to-black/20"
        >
          <section
            class="relative h-full flex flex-col items-center justify-center gap-4 sm:gap-5 md:gap-6 p-4 sm:p-6"
          >
            <span
              class="absolute top-2 sm:top-3 right-2 sm:right-3 px-2.5 sm:px-3 py-1 sm:py-1.5 glass text-slate-500 text-[11px] xs:text-xs sm:text-sm md:text-[15px] rounded-full font-semibold"
            >
              Binnenkort beschikbaar
            </span>

            <svg
              class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M7 10.0288C7.47142 10 8.05259 10 8.8 10H15.2C15.9474 10 16.5286 10 17 10.0288M7 10.0288C6.41168 10.0647 5.99429 10.1455 5.63803 10.327C5.07354 10.6146 4.6146 11.0735 4.32698 11.638C4 12.2798 4 13.1198 4 14.8V16.2C4 17.8802 4 18.7202 4.32698 19.362C4.6146 19.9265 5.07354 20.3854 5.63803 20.673C6.27976 21 7.11984 21 8.8 21H15.2C16.8802 21 17.7202 21 18.362 20.673C18.9265 20.3854 19.3854 19.9265 19.673 19.362C20 18.7202 20 17.8802 20 16.2V14.8C20 13.1198 20 12.2798 19.673 11.638C19.3854 11.0735 18.9265 10.6146 18.362 10.327C18.0057 10.1455 17.5883 10.0647 17 10.0288M7 10.0288V8C7 5.23858 9.23858 3 12 3C14.7614 3 17 5.23858 17 8V10.0288"
                stroke="#ffffff"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>

            <section>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-500 mb-2 sm:mb-3 text-center">
                MusicMatch
              </h3>
              <p class="text-sm sm:text-base text-slate-500 text-center">Organiseer jouw muziekcollectie</p>
            </section>
          </section>
        </article>
      </section>
      <dialog id="locked_modal" style="display:none" class="fixed inset-0 m-auto w-[90vw] max-w-[480px] h-48 sm:h-56 md:h-60 rounded-2xl glass-strong neon-cyan flex flex-col items-center justify-center text-lg sm:text-xl md:text-2xl text-slate-500 font-black gradient-text animate-gradient backdrop:bg-black/40 backdrop:backdrop-blur-lg px-4 text-center">
        <button id="modal-close" class="absolute right-2 sm:right-3 top-2 sm:top-3 p-1.5 sm:p-2 rounded-2xl backdrop-blur-xl transition-all duration-500 bg-white/3 text-slate-400 hover:text-white hover:scale-105 focus:outline-none" style="border:none;">
          <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g id="SVGRepo_iconCarrier">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M5.29289 5.29289C5.68342 4.90237 6.31658 4.90237 6.70711 5.29289L12 10.5858L17.2929 5.29289C17.6834 4.90237 18.3166 4.90237 18.7071 5.29289C19.0976 5.68342 19.0976 6.31658 18.7071 6.70711L13.4142 12L18.7071 17.2929C19.0976 17.6834 19.0976 18.3166 18.7071 18.7071C18.3166 19.0976 17.6834 19.0976 17.2929 18.7071L12 13.4142L6.70711 18.7071C6.31658 19.0976 5.68342 19.0976 5.29289 18.7071C4.90237 18.3166 4.90237 17.6834 5.29289 17.2929L10.5858 12L5.29289 6.70711C4.90237 6.31658 4.90237 5.68342 5.29289 5.29289Z" fill="currentColor"></path>
            </g>
          </svg>
        </button>
        Binnenkort beschikbaar...
      </dialog>

   <%- include("partials/footer") %>