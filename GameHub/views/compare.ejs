<%- include("partials/header", { scripts: ['/js/nav.js', '/js/active.js', '/js/compare.js'] }) %>
<%- include("partials/nav") %>


    <header class="text-center mt-8 md:mt-8 mb-12 px-4">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">
        Vergelijk
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500"
          >Games</span
        >
      </h1>
      <p class="text-lg text-slate-500 mt-6">
        Selecteer twee games om te vergelijken
      </p>
    </header>

    <main class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 pb-20">
      <section
        class="flex flex-col lg:flex-row items-center justify-between gap-26 mb-16"
      >
        <article class="relative group w-full flex-1 max-w-lg">
          <div class="relative">
            <div
              class="absolute inset-0 bg-cyan-500/40 rounded-[2rem] blur-lg group-hover:bg-cyan-500/60 transition duration-500"
            ></div>
            <div
              class="relative bg-black/60 backdrop-blur-xl border border-white/10 rounded-[2rem] overflow-hidden"
            >
              <figure class="relative">
                <img
                  id="game-img-1"
                  src=""
                  alt="Game 1"
                  class="w-full h-64 md:h-72 object-cover opacity-70 group-hover:opacity-100 transition duration-500"
                />
                <figcaption
                  class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-black/90 to-transparent"
                >
                  <h2
                    id="game-name-1"
                    class="text-2xl md:text-3xl font-bold mb-1"
                  >
                    Laden...
                  </h2>
                  <p
                    id="game-meta-1"
                    class="text-cyan-400 font-bold text-sm md:text-base"
                  >
                    -
                  </p>
                </figcaption>
              </figure>
            </div>
          </div>
          <div class="mt-4">
            <button
              id="button-change-1"
              class="w-full py-4 text-lg text-cyan-500 bg-white/5 hover:bg-cyan-500/20 border border-white/10 rounded-2xl font-bold transition-all"
            >
              Verander Game
            </button>
          </div>
        </article>

        <article class="relative group w-full flex-1 max-w-lg">
          <div class="relative">
            <div
              class="absolute inset-0 bg-purple-500/40 rounded-[2rem] blur-lg group-hover:bg-purple-500/60 transition duration-500"
            ></div>
            <div
              class="relative bg-black/60 backdrop-blur-xl border border-white/10 rounded-[2rem] overflow-hidden"
            >
              <figure class="relative">
                <img
                  id="game-img-2"
                  src=""
                  alt="Game 2"
                  class="w-full h-64 md:h-72 object-cover opacity-70 group-hover:opacity-100 transition duration-500"
                />
                <figcaption
                  class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-black/90 to-transparent"
                >
                  <h2
                    id="game-name-2"
                    class="text-2xl md:text-3xl font-bold mb-1"
                  >
                    Laden...
                  </h2>
                  <p
                    id="game-meta-2"
                    class="text-purple-400 font-bold text-sm md:text-base"
                  >
                    -
                  </p>
                </figcaption>
              </figure>
            </div>
          </div>
          <div class="mt-4">
            <button
              id="button-change-2"
              class="w-full py-4 text-lg text-purple-500 bg-white/5 hover:bg-purple-500/20 border border-white/10 rounded-2xl font-bold transition-all"
            >
              Verander Game
            </button>
          </div>
        </article>
      </section>

      <section
        class="max-w-4xl mx-auto bg-black/40 backdrop-blur-2xl border border-white/20 rounded-[2.5rem] p-6 md:p-10 shadow-2xl"
      >
        <h3
          class="text-2xl md:text-4xl pb-6 font-extrabold bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500 text-transparent text-center"
        >
          Statistieken
        </h3>

      <ul class="flex flex-col divide-y divide-white/10">
        <li class="grid grid-cols-3 items-center py-6 md:py-8">
          <span id="rating-1" class="text-lg md:text-xl font-mono text-slate-400 text-left">0.0</span>
          <div class="flex items-center justify-center gap-2 md:gap-3 text-center">
            <span class="arrow-left text-slate-500">—</span>
            <span class="text-slate-400 uppercase tracking-tighter font-bold text-[10px] md:text-sm">gebruikers beoordeling</span>
            <span class="arrow-right text-slate-500">—</span>
          </div>
          <span id="rating-2" class="text-lg md:text-xl font-mono text-slate-400 text-right">0.0</span>
        </li>

        <li class="grid grid-cols-3 items-center py-6 md:py-8">
          <span id="meta-rating-1" class="text-lg md:text-xl font-mono text-slate-400 text-left">0.0</span>
          <div class="flex items-center justify-center gap-2 md:gap-3 text-center">
            <span class="arrow-left text-slate-500">—</span>
            <span class="text-slate-400 uppercase tracking-tighter font-bold text-[10px] md:text-sm">metacritic</span>
            <span class="arrow-right text-slate-500">—</span>
          </div>
          <span id="meta-rating-2" class="text-lg md:text-xl font-mono text-slate-400 text-right">0.0</span>
        </li>

        <li class="grid grid-cols-3 items-center py-6 md:py-8">
          <span id="releasedate-1" class="text-sm md:text-xl font-mono text-slate-400 text-left">0000-00-00</span>
          <div class="flex items-center justify-center gap-2 md:gap-3 text-center">
            <span class="arrow-left text-slate-500">—</span>
            <span class="text-slate-400 uppercase tracking-tighter font-bold text-[10px] md:text-sm">uitgebracht</span>
            <span class="arrow-right text-slate-500">—</span>
          </div>
          <span id="releasedate-2" class="text-sm md:text-xl font-mono text-slate-400 text-right">0000-00-00</span>
        </li>

        <li class="grid grid-cols-3 items-center py-6 md:py-8">
          <span id="platform-1" class="text-lg md:text-xl font-mono text-slate-400 text-left">0</span>
          <div class="flex items-center justify-center gap-2 md:gap-3 text-center">
            <span class="arrow-left text-slate-500">—</span>
            <span class="text-slate-400 uppercase tracking-tighter font-bold text-[10px] md:text-sm">Platformen</span>
            <span class="arrow-right text-slate-500">—</span>
          </div>
          <span id="platform-2" class="text-lg md:text-xl font-mono text-slate-400 text-right">0</span>
        </li>
      </ul>
      </section>
  <%- include("partials/footer") %>