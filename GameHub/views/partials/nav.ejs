<nav
      class="relative w-full flex items-center justify-between px-4 sm:px-6 md:px-10 lg:px-24 h-20 bg-white/5 backdrop-blur-md border-b border-white/10"
    >
      <a
        href="/ontdek"
        class="text-3xl md:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent"
      >
        GameHub
      </a>

      <section
        class="hidden md:flex gap-8 text-slate-400 font-medium absolute left-1/2 -translate-x-1/2 translate-y-[6px]"
      >
        <a href="/ontdek" class="hover:text-white  <%= info.currentPage === "ontdek" ? "text-cyan-400" : "" %> ">Ontdek</a
        >
        <a href="/collection" class="hover:text-white <%= info.currentPage === "collectie" ? "text-cyan-400" : "" %> ">Collectie</a>
        <a href="/compare" class="hover:text-white <%= info.currentPage === "vergelijk" ? "text-cyan-400" : "" %> ">Vergelijk</a>
      </section>

      <section class="flex items-center pt-2 gap-3">
        <a
          href="/raad-page"
          class="flex items-center gap-2 bg-[#111827] border border-gray-700 px-3 sm:px-4 py-2 rounded-xl hover:bg-gray-800 transition text-xs sm:text-sm font-semibold"
        >
          <span class="text-cyan-400 text-sm">✦</span>
          <span>Raad de game</span>
        </a>
        
        <% if (user && user.avatar) { %>
            <img src="<%= user.avatar %>" alt="Avatar" class="hidden md:block w-10 h-10 rounded-full object-cover border-2 border-white/10">
        <% } %>
        <form action="/logout" method="POST" class="hidden md:block">
          <button type="submit" class="text-gray-400 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>
        </form> 

        <button id="menuBtn" class="md:hidden text-white p-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </section>
    </nav>
    
    <section
      class="w-full px-4 sm:px-6 md:px-10 lg:px-16 mt-4 sm:mt-6 relative z-10"
    >
      <section id="currentGameBanner"></section>
    </section>
    <section id="mobileMenu" class="fixed inset-0 z-50 hidden bg-[#050816]">
      <section
        class="relative w-full flex items-center justify-between pl-6 pr-4 h-20 bg-gradient-to-r from-black via-[#0b1120] to-[#1b1230] border-b border-white/10"
      >
        <a
          href="/"
          class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent"
        >
          GameHub
        </a>

        <section class="flex items-center pt-2 gap-3">
          <a
            href="/raad-page"
            class="flex items-center gap-2 bg-[#111827] border border-gray-700 px-4 py-2 rounded-xl hover:bg-gray-800 transition text-sm font-semibold"
          >
            <span class="text-cyan-400 text-sm">✦</span>
            <span>Raad de game</span>
          </a>

          <button id="closeMenuBtn" class="text-red-500 hover:text-red-400 hover:drop-shadow-[0_0_8px_rgba(239,68,68,0.8)] p-2 pr-0 shrink-0 transition-all duration-300">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </section>
      </section>

      <section
        class="h-[calc(100vh-89px)] flex flex-col items-center justify-center gap-15 text-slate-500 font-black text-5xl tracking-tight -mt-20"
      >
        <a href="/ontdek" class="hover:text-white transition">Ontdek</a>
        <a href="/collection" class="hover:text-white transition"
          >Collectie</a
        >
        <a href="/compare" class="hover:text-white transition"
          >Vergelijk</a
        >
      </section>

      <form action="/logout" method="POST" class="absolute bottom-8 right-6">
        <button type="submit" class="flex items-center gap-2 text-red-500 hover:text-red-400 hover:drop-shadow-[0_0_8px_rgba(239,68,68,0.8)] text-base font-semibold transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Logout
        </button>
      </form>
    </section>